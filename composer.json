{
    "name": "eduardoribeirodev/filament-canvas",
    "description": "Reusable visual document editor for Filament with pluggable persistence, assets and element types.",
    "version": "0.2.2",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/encryption": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "livewire/livewire": "^4.0",
        "spatie/laravel-medialibrary": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "EduardoRibeiroDev\\FilamentCanvas\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EduardoRibeiroDev\\FilamentCanvas\\CanvasServiceProvider"
            ]
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "EduardoRibeiroDev\\FilamentCanvas\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
